# ==============================================================================
# Daily Fresher Job Discovery Agent - Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      In PowerShell: Copy-Item .env.example .env
# 2. Fill in your actual credentials below.
# 3. DO NOT commit your real '.env' file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT SETTINGS (REQUIRED FOR NOTIFICATIONS)
# ------------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram to obtain TELEGRAM_BOT_TOKEN
# Get your numeric chat ID via @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_example
TELEGRAM_CHAT_ID=1234567890

# ------------------------------------------------------------------------------
# 2. SEARCH & DISCOVERY PROVIDER SETTINGS
# ------------------------------------------------------------------------------
# Options:
#   - ats_direct           : Built-in discovery querying official ATS APIs (Greenhouse, Lever, Ashby)
#                            and top Indian employer career feeds. No API key required! (DEFAULT)
#   - google_custom_search : Uses Google Programmable Search Engine API (requires SEARCH_API_KEY & SEARCH_ENGINE_ID)
#   - gemini               : Uses Gemini GenAI SDK for AI-augmented search queries (requires GEMINI_API_KEY)
#   - mock                 : Generates synthetic test listings for offline verification & testing
SEARCH_PROVIDER=ats_direct

# (Optional) Google Custom Search API Credentials
# Get an API Key at: https://developers.google.com/custom-search/v1/overview
# Create a Search Engine at: https://programmablesearchengine.google.com/
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# (Optional) Google Gemini API Key
# Get your API key at: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 3. AGENT OPERATIONAL SETTINGS
# ------------------------------------------------------------------------------
# Local path to SQLite jobs database
DATABASE_PATH=data/jobs_cache.db

# Recency window in hours (default: 48 hours)
LOOKBACK_HOURS=48

# Minimum relevance score to trigger a Telegram alert (0 - 100)
MIN_RELEVANCE_SCORE=55

# Company Diversity Balancing: Maximum opportunities per company per alert batch (prevents flooding from 1 company)
MAX_JOBS_PER_COMPANY=2

# Maximum total opportunities sent per daily alert
MAX_DAILY_ALERTS=15

# Strictly enforce India location / Remote in India (rejects foreign jobs e.g. US, UK, Tokyo)
ENFORCE_INDIA_LOCATION=true

# Strictly exclude non-technical roles (copywriters, content writers, sales, illustrators)
EXCLUDE_NON_TECH_ROLES=true

# Send a daily "No new verified jobs found" message if no jobs match today (true/false)
SEND_EMPTY_REPORT=true

# Allow unconfirmed jobs in a separate Telegram section (true/false, default: false)
INCLUDE_UNCONFIRMED_ALERTS=false

# Target candidate graduation batch (e.g. 2027)
TARGET_GRADUATION_BATCH=2027

# Target country (e.g. India)
TARGET_COUNTRY=India

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

